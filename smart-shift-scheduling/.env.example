# Chạy local: copy thành .env. Bỏ trống Supabase để dùng dữ liệu local.
PORT=5000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
JWT_SECRET=replace-with-a-long-random-secret

# Điền cả 3 giá trị nếu dùng Supabase; không đưa service role key lên frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tùy chọn: SMTP thực tế để gửi email. Có thể bỏ trống khi thử local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
COUNTDOWN_HOURS=5
